# Copy to phase8_p0_gnn_training_job.env (gitignored).
GNN_MODE=development
GNN_STAGES=train-gnn
GNN_SEED=20260617
GNN_TOP_K=1,3,5,10
GNN_FOLD_COUNT=5
GNN_SHARD_COUNT=256
GNN_BATCH_RANKING_GROUPS=32
GNN_GRADIENT_ACCUMULATION_GROUPS=32
GNN_MAX_EDGES_PER_BATCH=100000
GNN_MAX_NODES_PER_BATCH=8192
GNN_PROGRESS_INTERVAL_BATCHES=100
GNN_MAX_EPOCHS=30
GNN_EARLY_STOPPING_PATIENCE=3
GNN_MIXED_PRECISION=1
GNN_PRECISION=bf16
GNN_DEVICE=cuda
DUCKDB_THREADS=8
DUCKDB_MEMORY_LIMIT=24GB

# For a one-shot final run, set GNN_MODE=final, choose exactly one stage
# (score-gnn or score-fusion), and uncomment the confirmation:
# GNN_STAGES=score-fusion
# GNN_FINAL_SCORE_CONFIRM=I_UNDERSTAND_ONE_SHOT

# For one array-addressed fold task, use GNN_STAGES=train-gnn-fold and set:
# GNN_ABLATION_VARIANT=full
# GNN_HELD_OUT_FOLD=0
