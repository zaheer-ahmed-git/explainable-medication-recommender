# Copy to phase8_p0_gnn_prepare_job.env (gitignored) after reviewing capacity.
# WORK_SCRATCH must be a real Calculco scratch path; OAR jobs do not inherit
# interactive-shell exports from the submit host.
WORK_SCRATCH=/workdir/<lab>/<username>
GNN_MODE=development
GNN_SEED=20260617
GNN_TOP_K=1,3,5,10
GNN_FOLD_COUNT=5
GNN_SHARD_COUNT=256
GNN_DEVICE=cpu
GNN_CROSSFIT_MIN_FREE_GIB=REPLACE_WITH_REVIEWED_VALUE
# Keep threads low; raise memory on 512 GB CPU nodes. Spill to WORK_SCRATCH.
DUCKDB_THREADS=4
DUCKDB_MEMORY_LIMIT=128GB
DUCKDB_MAX_TEMP_DIR_SIZE=400GB
